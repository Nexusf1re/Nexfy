<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of "Nexfy · Barra"; mirrors NexfyWidget's wide layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_artist"
            android:textColor="@color/widget_quiet"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_widget_previous"
        android:tint="@color/widget_text" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_preview_button"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_on_button" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_widget_next"
        android:tint="@color/widget_text" />
</LinearLayout>
